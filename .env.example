# Server-side only. Set these in Vercel: Project > Settings > Environment Variables.
# Nothing here is ever sent to the browser.

# --- Scout, the projects agent (/assistant.html, api/assistant.js) ---
# Create the key under the team's AI Gateway tab. Without it the page shows "not configured".
AI_GATEWAY_API_KEY=

# The switch. Set to false to stop every AI request; the page then shows "Scout is paused"
# and the projects page and Career Match still work.
ASSISTANT_ENABLED=true

# Model id as the AI Gateway names it, and the only providers allowed to serve it. With
# `only` set, the gateway fails the request instead of routing it to another provider.
# Same defaults as COB's assistant, so both sites can share one gateway.
ASSISTANT_MODEL=minimax/minimax-m3.1-flash
ASSISTANT_PROVIDERS=minimax

# The beta gate: a name and an email before the chat opens, checked on every turn.
# "off" removes the requirement without a code change.
ASSISTANT_GATE=on

# Where the sign-ins (name, email, first question, time) are kept beyond the function log:
# the Supabase project's URL and its service_role key (Project Settings > API). Both unset =
# log only. The table is public.bb_assistant_visitors (see README, "The beta gate").
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional tuning.
# ASSISTANT_REASONING_EFFORT=low      # gateway "reasoning.effort" extension; unset = model default
# ASSISTANT_DAILY_CAP=400             # requests per day per function instance, all visitors
# ASSISTANT_TIMEOUT_MS=45000
# ASSISTANT_MAX_TOKENS=1800
# ASSISTANT_DEBUG=1                   # log each stage to the function logs
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# SUPABASE_VISITORS_TABLE=bb_assistant_visitors

# --- Other functions ---
# SUGGEST_WEBHOOK_URL=                # api/suggest.js: where "Suggest a project" posts
# PREMIUM_PASSWORD=                   # api/premium-login.js: the shared premium password
